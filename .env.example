# Tomodachi POS - Configuración Docker (opcional)
# Copia este archivo a .env y ajusta los valores si lo necesitas.

# Puerto del host para acceder a la web (http://localhost:8080)
PORT=8080

# Base de datos
DB_NAME=tomodachi_pos
DB_USER=tomodachi
DB_PASS=tomodachi_secret
MARIADB_ROOT_PASSWORD=tomodachi_root_secret

# Modo de la aplicación
# OPEN_SOURCE = todas las funciones desbloqueadas (recomendado para self-hosting)
# SAAS = planes freemium (para el proveedor de hosting gestionado)
APP_MODE=OPEN_SOURCE

# Datos demo al primer arranque (true = carga tienda demo + ventas históricas)
SEED_DEMO=true

# Zona horaria
TZ=America/Mexico_City

# URL pública de la instalación. OBLIGATORIA para cualquier enlace que salga
# firmado o por correo: la recuperación de contraseña arma
# <APP_URL>/public/reset_password.html?token=… y ese enlace lleva el token en
# claro. Con APP_URL vacía el enlace saldría del header `Host` de la petición
# —que lo elige el cliente—, así que un `Host: evil.com` mandaría el token al
# servidor del atacante. Por eso `api/auth/forgot_password.php` FALLA CERRADO
# (error 500 y ni correo ni token) si APP_URL está vacía: si actualizas desde una
# versión anterior, define esta variable o la recuperación de contraseña dejará
# de funcionar (a propósito, no es un bug).
# Sustituye el ejemplo por TU dominio real, con su esquema.
APP_URL=https://pos.midominio.com

# Salud (api/health/ready.php, la que usa el HEALTHCHECK del contenedor)
# Espacio libre mínimo, en MB, que debe quedar en el disco de la app.
HEALTH_MIN_FREE_MB=200
# Token opcional: con esto, un monitor EXTERNO ve el detalle de los checks
# (header X-Health-Token). Vacío = el detalle solo se ve desde dentro del
# contenedor. Es información de diagnóstico, no un dato de negocio.
HEALTH_TOKEN=

# Secreto compartido del tiempo real (canales de tienda/estación/cuenta del relay
# WebSocket) y del token de LECTURA del carrito del display de cliente. Debe ser el
# MISMO valor para la app y para el servicio de WebSocket; genera uno largo y aleatorio.
#
# Sin WS_SECRET (o vacío):
#   - el tiempo real no se puede firmar: el relay rechaza los canales que exigen token;
#   - el display de cliente NO puede leer el carrito desde otro dispositivo, porque la
#     lectura por token no existe (fail closed). En el MISMO navegador del punto de venta
#     sí funciona, porque el display lleva la sesión.
#   - el POST de cart_sync.php responde `cart_token: null` y el enlace copiado no lleva
#     `&exp=&token=`.
WS_SECRET=
