# Tomodachi POS - Configuración Docker (opcional)
# Copia este archivo a .env y ajusta los valores si lo necesitas.

# Puerto del host para acceder a la web (http://localhost:8080)
PORT=8080

# Base de datos
DB_NAME=tomodachi_pos
DB_USER=tomodachi
DB_PASS=tomodachi_secret
MARIADB_ROOT_PASSWORD=tomodachi_root_secret

# Modo de la aplicación
# OPEN_SOURCE = todas las funciones desbloqueadas (recomendado para self-hosting)
# SAAS = planes freemium (para el proveedor de hosting gestionado)
APP_MODE=OPEN_SOURCE

# Datos demo al primer arranque (true = carga tienda demo + ventas históricas)
SEED_DEMO=true

# Zona horaria
TZ=America/Mexico_City
