# Tomodachi POS - Git Ignore

# Archivos de configuración sensibles
config/database.php
config/mail.php

# Archivos de sistema
.DS_Store
Thumbs.db
*.log

# Directorios temporales
/temp/
/cache/
/uploads/

# Imágenes de productos (generadas dinámicamente)
public/assets/images/products/
public/assets/images/logos/
public/assets/images/backgrounds/

# Archivos de IDE
.vscode/
.idea/
*.sublime-*

# Dependencias (se instalan con composer install / npm install)
/vendor/
/node_modules/

# Composer descargable
composer.phar

# Archivos de backup
*.bak
*.backup
*.old
database/backups/*.sql

# Configuración de IA
api/ai/config.php

# Entorno Docker
.env
