# Tomodachi POS - Apache Configuration

# Prevenir acceso directo a archivos de configuración
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Proteger archivos sensibles
<FilesMatch "\.(sql|log|txt|md)$">
    Require all denied
</FilesMatch>

# Proteger directorios del sistema (No accesibles vía navegador)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|database|codi/includes|codi/database|codi/config|codi/tests)/ - [F,L]
    # Propagar header Authorization para API tokens (Bearer)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Propagar headers de webhook
    RewriteCond %{HTTP:X-Webhook-Signature} .
    RewriteRule ^codi/api/webhook\.php$ - [E=HTTP_X_WEBHOOK_SIGNATURE:%{HTTP:X-Webhook-Signature}]
</IfModule>

# Configuración de PHP (para PHP 8.x)
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
</IfModule>

# Redirigir a la página principal (index.html) si se accede a la raíz
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteRule ^$ public/index.html [L,R=302]
# </IfModule>

# Definir el archivo por defecto
DirectoryIndex index.php index.html public/index.html
